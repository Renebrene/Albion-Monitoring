# /etc/nginx/sites-available/albion-monitoring
# Replace albion.example.com and certificate paths.

limit_req_zone $binary_remote_addr zone=albion_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=albion_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name albion.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name albion.example.com;

    ssl_certificate     /etc/letsencrypt/live/albion.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/albion.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    client_max_body_size 110m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer" always;

    # Do not expose API docs or the users directory on the public internet.
    location = /docs { return 404; }
    location = /redoc { return 404; }
    location = /openapi.json { return 404; }
    location = /api/login-users { return 404; }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    location = /api/login {
        limit_req zone=albion_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:18000;
    }

    location / {
        limit_req zone=albion_general burst=60 nodelay;
        proxy_pass http://127.0.0.1:18000;
    }
}
