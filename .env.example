# Секретный ключ для подписи JWT-токенов
# ОБЯЗАТЕЛЬНО замените на случайную строку (минимум 32 символа)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Пути (обычно не нужно менять)
DB_PATH=/data/monitoring.db
UPLOADS_DIR=/uploads

# Необязательный выделенный private-каталог для новых фото/видео.
# Оставьте пустым для прежнего локального UPLOADS_DIR. При включении
# задайте каталог вне публичного UPLOAD_FOLDER Albion Files и смонтируйте его
# с минимальными правами для Linux service user обоих приложений.
# Исторические медиа остаются в UPLOADS_DIR.
PRIVATE_MEDIA_DIR=

